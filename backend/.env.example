# Backend Environment Variables

PORT=4000

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/agentguard

# Redis Connection Details for BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# The AI Engine webhook or local endpoint
AI_ENGINE_URL=http://localhost:8000/eval

# Gemini API Key for LLM Evaluation and Scenario Generation
GEMINI_API_KEY=your_gemini_api_key_here
